# Server-side only. Never prefix this with VITE_ and never commit the real key.
OPENROUTER_API_KEY=your_openrouter_key_here

# Recommended free model for this e-commerce assistant.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Used automatically if the selected free model is rate-limited or temporarily unavailable.
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Optional metadata sent to OpenRouter.
OPENROUTER_SITE_URL=https://your-project.vercel.app
OPENROUTER_APP_NAME=E-Commerce AI

# Optional: only needed if you later connect a separate legacy backend.
# VITE_API_URL=https://your-backend.example.com
